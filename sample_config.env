# Telegram (required)
API_ID=""
API_HASH=""
BOT_TOKEN=""
OWNER_ID=""

# Database (required — comma-separated URIs, exactly 2: tracking, storage_1)
DATABASE=""

# Server (required)
PORT="8000"

# Cloudflare Streaming Workers
# Single worker (legacy support)
CF_STREAM_URL="https://your-worker.workers.dev"
CF_STREAM_SECRET="your-worker-secret"

# Multiple workers (JSON list of [url, secret] pairs)
# Example: [["https://worker1.workers.dev", "secret1"], ["https://worker2.workers.dev", "secret2"]]
CF_WORKERS='[["https://worker1.workers.dev", "secret1"], ["https://worker2.workers.dev", "secret2"]]'

# Load balancing strategy: "round-robin", "least-loaded", or "random"
CF_LOAD_STRATEGY="round-robin"

# Show all workers as separate stream options (otherwise, one auto-balanced stream)
SHOW_ALL_WORKERS="false"

# Stremio link mode: "off", "cloudflare", or "both"
CF_STREAM_MODE="both"
